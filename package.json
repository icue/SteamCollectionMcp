{
  "name": "steam-collection-mcp",
  "version": "1.0.2",
  "description": "A lightweight, stateless, read-only MCP server for querying your Steam game library and wishlist, with multilingual game name resolution.",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "steam-collection-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.13.14",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icue/SteamCollectionMcp.git"
  },
  "homepage": "https://github.com/icue/SteamCollectionMcp#readme",
  "bugs": {
    "url": "https://github.com/icue/SteamCollectionMcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "steam",
    "steam-library",
    "steam-wishlist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
